# Static-asset cache rules — Workers Static Assets honors this file.
# HTML pages are served through the Worker (run_worker_first) with
# cache-control: no-cache, so deploys are never hidden behind a stale cache.
/images/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600
/geojson/*
  Cache-Control: public, max-age=3600
/lidar/libs/*
  Cache-Control: public, max-age=604800, immutable
